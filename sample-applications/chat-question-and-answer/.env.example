# Copy to .env and replace local secrets/settings. The Fedora runner detects HOST_IP and DEVICE.
HOST_IP=
# Set a strong initial admin password before the first deployment.
# If this is unset, login and account creation remain disabled until setup is completed.
CHATQNA_ADMIN_PASSWORD=
# Optional for public models. Required for gated/private models.
HUGGINGFACEHUB_API_TOKEN=
# The launcher generates this if blank. Keep it stable; losing it makes saved tokens unreadable.
HF_TOKEN_ENCRYPTION_KEY=
# The launcher generates this if blank; keep it stable across restarts.
MODEL_DOWNLOAD_TOKEN_EXCHANGE_KEY=
# The launcher generates this if blank; keep it stable across restarts.
MODEL_DOWNLOAD_SERVICE_TOKEN=
LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2
# Keep DEVICE, COMPOSE_PROFILES, and STARTUP_MODELS_CONFIG_HOST_PATH aligned:
# CPU uses CPU / OVMS / startup-models-cpu.yaml; GPU uses GPU / GPU-OVMS / startup-models-gpu.yaml.
DEVICE=CPU
ALLOWED_HOSTS=*
REGISTRY=intel/
TAG=latest
BE_IMAGE_NAME=intel/chatqna:latest
FE_IMAGE_NAME=intel/chatqna-ui:latest
APP_METRICS_URL=http://localhost:9090/metrics/stream
# Optional JSON: {"CPU":"...","GPU":"...","RAM":"...","OS":"..."}.
# Hardware details appear beside the metrics; OS appears in the navbar.
APP_SYSTEM_INFO=
GETI_SERVER_SSL_VERIFY=False

COMPOSE_PROFILES=OVMS
CONTAINER_ENGINE=auto
ENDPOINT_URL=http://ovms-service:8080/v3
EMBEDDING_ENDPOINT_URL=http://ovms-service:8080/v3
MAX_TOKENS=32768
APP_ENDPOINT_URL=/v1/chatqna
APP_DATA_PREP_URL=/v1/dataprep
AUTH_COOKIE_SECURE=false
RERANKER_ENDPOINT=http://reranker/rerank
MODEL_DOWNLOAD_HOST_PORT=8200
MODEL_DOWNLOAD_PLUGINS=huggingface,openvino
MODEL_PATH=./ovms/models
STARTUP_MODELS_CONFIG_HOST_PATH=./startup-models-cpu.yaml
HOST_UID=1000
USER_GROUP_ID=1000
# Image tag without the v prefix; Compose adds it for the model downloader.
OVMS_RELEASE_TAG=2026.4.1
WEIGHT_FORMAT=int8
TENSOR_PARALLEL_SIZE=1
KVCACHE_SPACE=50

PGVECTOR_HOST=pgvector_db
PGVECTOR_PORT=5432
PGVECTOR_USER=langchain
PGVECTOR_PASSWORD=langchain
PGVECTOR_DBNAME=langchain
PG_CONNECTION_STRING=postgresql+psycopg://langchain:langchain@pgvector_db:5432/langchain
INDEX_NAME=intel-rag
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
FETCH_K=10
BATCH_SIZE=32
SEED=42

MINIO_HOST=minio-server
MINIO_API_PORT=9000
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
model_cache_path=${HOME}/.cache/huggingface
VOLUME_OVMS=./ovms
CA_CERTIFICATES_PATH=/etc/ssl/certs
SSL_CERTIFICATES_PATH=/etc/ssl/certs

HOST_METRICS_PORT=9090
HOST_TELEGRAF_PORT=9273
HOST_TELEGRAF_HTTP_PORT=8186
PRIVILEGED=true
LOG_LEVEL=INFO
CORS_ORIGINS=*
OTLP_ENDPOINT=
OTLP_ENDPOINT_TRACE=
OTLP_SERVICE_NAME=chatqna
OTLP_SERVICE_ENV=chatqna
OTEL_SERVICE_VERSION=1.0.0
REQUESTS_CA_BUNDLE=

http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,host.containers.internal,pgvector_db,metrics-manager,model-download,tei-embedding-service,ovms-service,reranker
# Set this to the host render-device GID when using GPU-OVMS without the Fedora runner.
RENDER_DEVICE_GID=0